{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "login": true,
  "steps": [
    { "step": "defineWpConfigConsts", "consts": { "WP_DEBUG": true, "WP_DEBUG_DISPLAY": true, "WP_DEBUG_LOG": "/wordpress/akksp-seed/debug.log" } },
    { "step": "installTheme", "themeData": { "resource": "wordpress.org/themes", "slug": "hello-elementor" }, "options": { "activate": false } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "elementor" }, "options": { "activate": true } },
    { "step": "setSiteOptions", "options": { "elementor_onboarded": true } }
  ]
}
